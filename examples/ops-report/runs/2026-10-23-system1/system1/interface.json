{
 "dock_email_summary": {
  "description": "Counts Approved versus Requested dock appointments from the dock-activity email threads and lists the outstanding requests not yet approved.",
  "output_fields": [
   {
    "description": "Number of Approved appointments",
    "enum": [],
    "items": "",
    "nullable": false,
    "path": "approved_count",
    "required": true,
    "type": "integer"
   },
   {
    "description": "Number of Requested appointments",
    "enum": [],
    "items": "",
    "nullable": false,
    "path": "requested_count",
    "required": true,
    "type": "integer"
   },
   {
    "description": "Requests not yet approved",
    "enum": [],
    "items": "object",
    "nullable": false,
    "path": "outstanding_requests",
    "required": true,
    "type": "array"
   },
   {
    "description": "Gmail thread id",
    "enum": [],
    "items": "",
    "nullable": true,
    "path": "outstanding_requests[].thread_id",
    "required": false,
    "type": "string"
   },
   {
    "description": "Email subject of the request",
    "enum": [],
    "items": "",
    "nullable": false,
    "path": "outstanding_requests[].subject",
    "required": true,
    "type": "string"
   },
   {
    "description": "Email sender",
    "enum": [],
    "items": "",
    "nullable": true,
    "path": "outstanding_requests[].sender",
    "required": false,
    "type": "string"
   },
   {
    "description": "Email date",
    "enum": [],
    "items": "",
    "nullable": true,
    "path": "outstanding_requests[].date",
    "required": false,
    "type": "string"
   },
   {
    "description": "Snippet of latest message",
    "enum": [],
    "items": "",
    "nullable": true,
    "path": "outstanding_requests[].snippet",
    "required": false,
    "type": "string"
   },
   {
    "description": "Number of outstanding requests",
    "enum": [],
    "items": "",
    "nullable": false,
    "path": "outstanding_count",
    "required": true,
    "type": "integer"
   }
  ],
  "output_schema": {
   "properties": {
    "approved_count": {
     "description": "Number of Approved appointments",
     "type": "integer"
    },
    "outstanding_count": {
     "description": "Number of outstanding requests",
     "type": "integer"
    },
    "outstanding_requests": {
     "description": "Requests not yet approved",
     "items": {
      "properties": {
       "date": {
        "description": "Email date",
        "type": [
         "string",
         "null"
        ]
       },
       "sender": {
        "description": "Email sender",
        "type": [
         "string",
         "null"
        ]
       },
       "snippet": {
        "description": "Snippet of latest message",
        "type": [
         "string",
         "null"
        ]
       },
       "subject": {
        "description": "Email subject of the request",
        "type": "string"
       },
       "thread_id": {
        "description": "Gmail thread id",
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "subject"
      ],
      "type": "object"
     },
     "type": "array"
    },
    "requested_count": {
     "description": "Number of Requested appointments",
     "type": "integer"
    }
   },
   "required": [
    "approved_count",
    "requested_count",
    "outstanding_requests",
    "outstanding_count"
   ],
   "type": "object"
  }
 },
